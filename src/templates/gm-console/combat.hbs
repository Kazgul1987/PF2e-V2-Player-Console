<section class="tab gm-primary-panel gm-combat {{tab.cssClass}}" data-group="gm-console-primary" data-tab="combat">
    <div class="gm-combat-panes">
    {{#each combatants}}
        <article class="gm-combat-npc{{#if isCurrentTurn}} is-current-turn{{/if}}{{#if defeated}} is-defeated{{/if}}" data-combatant-id="{{id}}" data-actor-id="{{actorId}}">
            <header class="gm-pane-header">
                <img src="{{img}}" alt="{{name}}" width="48" height="48">
                <div class="gm-pane-identity">
                    <h3>{{#if isCurrentTurn}}<i class="fa-solid fa-play gm-current-turn-icon" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.CurrentTurn'}}" inert></i> {{/if}}{{name}}</h3>
                    <small>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Initiative"}} {{#if hasInitiative}}{{initiative}}{{else}}—{{/if}}</small>
                    <span class="gm-header-status"><span>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.HPShort"}} {{hp.value}}/{{hp.max}}</span><span>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.ACShort"}} {{ac}}</span></span>
                </div>
                <button type="button" class="gm-open-npc" data-action="openCombatantSheet" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.GMConsole.OpenSheet'}}"><i class="fa-solid fa-window-restore" inert></i></button>
            </header>
            <nav class="gm-pane-navigation" data-group="{{tabGroup}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Views'}}">
                <button type="button" data-action="switchCombatView" data-view="overview" class="{{#if isOverview}}active{{/if}}" aria-pressed="{{isOverview}}">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Overview"}}</button>
                <button type="button" data-action="switchCombatView" data-view="actions" class="{{#if isActions}}active{{/if}}" aria-pressed="{{isActions}}">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Actions"}}</button>
                <button type="button" data-action="switchCombatView" data-view="inventory" class="{{#if isInventory}}active{{/if}}" aria-pressed="{{isInventory}}">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Inventory"}}</button>
                {{#if hasSpellcasting}}<button type="button" data-action="switchCombatView" data-view="spellcasting" class="{{#if isSpellcasting}}active{{/if}}" aria-pressed="{{isSpellcasting}}">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Spellcasting"}}</button>{{/if}}
            </nav>
            {{#if isOverview}}
                <dl class="gm-summary"><div><dt>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Level"}}</dt><dd>{{level}}</dd></div><div><dt>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.AC"}}</dt><dd>{{ac}}</dd></div><div><dt>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.Speed"}}</dt><dd>{{speed}}</dd></div></dl>
                <section class="gm-resource"><label>{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.HP"}} <input type="number" data-field="hp" value="{{hp.value}}" min="0" max="{{hp.max}}"> / {{hp.max}}</label><div class="gm-hp-bar" role="progressbar" aria-valuenow="{{hp.value}}" aria-valuemin="0" aria-valuemax="{{hp.max}}"><span style="width: {{hp.pct}}%"></span></div></section>
                {{#if conditions.length}}<div class="gm-condition-list">{{#each conditions}}<span class="gm-condition-chip">{{name}}</span>{{/each}}</div>{{/if}}
                <div class="gm-statistics">
                    <button type="button" data-action="rollCombatStatistic" data-statistic="perception">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Perception"}} <strong>{{numberFormat perception sign=true}}</strong></button>
                    <button type="button" data-action="rollCombatStatistic" data-statistic="fortitude">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Fortitude"}} <strong>{{numberFormat fortitude sign=true}}</strong></button>
                    <button type="button" data-action="rollCombatStatistic" data-statistic="reflex">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Reflex"}} <strong>{{numberFormat reflex sign=true}}</strong></button>
                    <button type="button" data-action="rollCombatStatistic" data-statistic="will">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Will"}} <strong>{{numberFormat will sign=true}}</strong></button>
                </div>
            {{else if isActions}}
                {{> "modules/pf2e-v2-player-console/src/templates/gm-console/combat-actions.hbs"}}
            {{else if isInventory}}
                {{> "modules/pf2e-v2-player-console/src/templates/gm-console/inventory.hbs"}}
            {{else if isSpellcasting}}
                {{> "modules/pf2e-v2-player-console/src/templates/gm-console/spellcasting.hbs"}}
            {{/if}}
        </article>
    {{else}}<p class="gm-empty">{{localize "PF2E_V2_PLAYER_CONSOLE.GMConsole.Combat.NoNPCs"}}</p>{{/each}}
    </div>
</section>
