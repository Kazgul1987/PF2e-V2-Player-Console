<section class="tab-panel tab {{tab.cssClass}} feats-tab" data-group="primary" data-tab="feats">
    <header class="feats-overview">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Tabs.feats"}}</h2>
    </header>
    {{#each feats.groups as |group|}}
        <section class="feat-section" data-group-id="{{group.id}}">
            <h3>{{group.label}}</h3>
            <ol class="feat-list">
                {{#each group.entries as |entry|}}{{> featEntry entry=entry editable=@root.editable}}{{/each}}
            </ol>
        </section>
    {{/each}}
</section>

{{#*inline "featEntry"}}
<li class="feat-entry {{#unless entry.feat}}empty{{/unless}}" data-group-id="{{entry.groupId}}" {{#if entry.slotId}}data-slot-id="{{entry.slotId}}"{{/if}} {{#if entry.feat}}data-item-id="{{entry.feat.id}}" {{#if editable}}{{#if entry.feat.movable}}draggable="true"{{/if}}{{/if}}{{/if}}>
    {{#if entry.feat}}
        <button type="button" class="feat-name" data-action="featSummary">
            <img src="{{entry.feat.img}}" alt="">
            <span><strong>{{entry.feat.name}}</strong>{{#if entry.slotLabel}}<small>{{entry.slotLabel}}</small>{{/if}}</span>
        </button>
        <span class="feat-level">{{localize "PF2E.LevelLabel"}} {{entry.feat.level}}</span>
        <span class="feat-meta">
            {{#if entry.feat.actionCost}}<span class="action-glyph" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Labels.ActionCost'}}">{{{actionGlyph entry.feat.actionCost}}}</span>{{else}}<span class="passive">{{localize "PF2E_V2_PLAYER_CONSOLE.Labels.Passive"}}</span>{{/if}}
            {{#if entry.feat.category}}<span>{{entry.feat.category}}</span>{{/if}}
            <span class="trait-list">{{#each entry.feat.traits as |trait|}}<span class="trait">{{trait.label}}</span>{{/each}}</span>
        </span>
        <span class="item-controls">
            <button type="button" data-action="featToChat" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Actions.SendToChat'}}"><i class="fa-solid fa-message"></i></button>
            <button type="button" data-action="openFeat" title="{{localize 'PF2E.EditItemTitle'}}"><i class="fa-solid fa-up-right-from-square"></i></button>
            {{#if editable}}<button type="button" data-action="deleteFeat" title="{{localize 'PF2E.DeleteItemTitle'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
        </span>
        <div class="item-summary" hidden></div>
    {{else}}
        <span class="feat-slot-label">{{entry.slotLabel}}</span><span class="feat-placeholder">{{entry.placeholder}}</span>
    {{/if}}
    {{#if entry.hasChildren}}<ol class="feat-list nested">{{#each entry.children as |child|}}{{> featEntry entry=child editable=../editable}}{{/each}}</ol>{{/if}}
</li>
{{/inline}}
