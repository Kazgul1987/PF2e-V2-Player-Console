<section class="tab-panel tab {{tab.cssClass}}" data-group="primary" data-tab="character">
    <section class="dashboard-section attributes-section">
        <header class="dashboard-heading"><h2>{{localize "PF2E.Actor.Creature.AttributeModifiers"}}</h2>{{#if editable}}<button type="button" data-action="editAttributeBoosts" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Character.CoreEditorNotice'}}"><i class="fa-solid fa-pen-to-square"></i> {{localize "PF2E.Edit"}}</button>{{/if}}</header>
        <div class="attribute-grid">{{#each actor.attributes}}<div class="attribute-card"><span>{{label}}</span><strong>{{modifier}}</strong></div>{{/each}}</div>
    </section>
    <section class="dashboard-section speed-section">
        <div class="speed-list"><h2>{{localize "PF2E.Actor.Speed.Label"}}</h2>{{#each actor.speeds}}<span><strong>{{label}}</strong> {{value}} {{localize "PF2E.TravelSpeed.FeetAcronym"}}</span>{{/each}}</div>
    </section>
    {{#if actor.shield}}<section class="dashboard-section defense-section">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Character.Defense"}}</h2>
        <div class="shield-details"><strong class="shield-name">{{actor.shield.name}}</strong><span>{{localize "PF2E.HardnessLabel"}} <strong>{{actor.shield.hardness}}</strong></span><span>HP <strong>{{actor.shield.hp.value}} / {{actor.shield.hp.max}}</strong></span><span>{{localize "PF2E.Actor.Creature.Shield.BrokenThreshold"}} <strong>{{actor.shield.brokenThreshold}}</strong></span>{{#if actor.shield.raised}}<span class="trait">{{localize "PF2E_V2_PLAYER_CONSOLE.Character.ShieldRaised"}}</span>{{/if}}{{#if actor.shield.broken}}<span class="trait">{{localize "PF2E.Item.Physical.Broken"}}</span>{{/if}}{{#if actor.shield.destroyed}}<span class="trait">{{localize "PF2E.Item.Physical.Destroyed"}}</span>{{/if}}</div>
    </section>{{/if}}
    <section class="dashboard-section perception-section">
        <header class="section-header"><h2>{{localize "PF2E.PerceptionHeader"}}</h2></header>
        <button type="button" class="stat-card rollable" data-action="rollStatistic" data-statistic="perception"><span>{{localize "PF2E.PerceptionHeader"}}</span><strong>{{actor.perception.modifier}}</strong></button>
        <button type="button" class="stat-card rollable" data-action="rollStatistic" data-statistic="perception" data-secret aria-label="{{localize 'PF2E.Check.Specific.Perception.Secret'}}"><i class="fa-solid fa-eye-slash"></i> {{localize "PF2E_V2_PLAYER_CONSOLE.Actions.SecretPerception"}}</button>
    </section>
    <section><h2>{{localize "PF2E.SavesHeader"}}</h2><div class="stat-grid">{{#each actor.saves}}<button type="button" class="stat-card rollable" data-action="rollStatistic" data-statistic="{{slug}}"><span>{{label}}</span><strong>{{modifier}}</strong></button>{{/each}}</div></section>
    <section><h2>{{localize "PF2E.SkillsLabel"}}</h2><div class="stat-grid skills">{{#each actor.skills}}<button type="button" class="stat-card rollable" data-action="rollStatistic" data-statistic="{{slug}}"><span>{{label}}</span><strong>{{modifier}}</strong></button>{{/each}}</div></section>
    <section class="dashboard-section languages-section"><header class="dashboard-heading"><h2>{{localize "PF2E.Actor.Creature.Language.Plural"}}</h2>{{#if editable}}<button type="button" data-action="editLanguages" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Character.CoreEditorNotice'}}"><i class="fa-solid fa-pen-to-square"></i> {{localize "PF2E.Edit"}}</button>{{/if}}</header><div class="language-list">{{#each actor.languages}}<span class="trait">{{label}}</span>{{else}}<span>—</span>{{/each}}</div></section>
</section>
