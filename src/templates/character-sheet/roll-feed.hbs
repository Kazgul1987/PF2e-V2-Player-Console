<section class="roll-feed {{#if rollFeed.collapsed}}collapsed{{/if}}" data-actor-uuid="{{rollFeed.actorUuid}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.RollFeed.Title'}}">
    <header class="roll-feed-heading">
        <button type="button" data-action="toggleRollFeed" aria-expanded="{{#unless rollFeed.collapsed}}true{{else}}false{{/unless}}">
            <span>{{localize "PF2E_V2_PLAYER_CONSOLE.RollFeed.Title"}}</span>
            <i class="fa-solid {{#if rollFeed.collapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
        </button>
        <button type="button" data-action="clearRollFeed" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.RollFeed.ClearHistory'}}" {{#if rollFeed.empty}}disabled{{/if}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
    </header>
    {{#unless rollFeed.collapsed}}
        <div class="roll-feed-entries">
            {{#each rollFeed.entries}}
                <article class="roll-feed-entry roll-feed-{{type}}" data-message-id="{{id}}">
                    {{#if (eq type "request")}}
                        <strong>{{author}}</strong>
                        <div class="roll-feed-request-content">{{{checks}}}</div>
                    {{else if (eq type "saves-helper-request")}}
                        <div class="roll-feed-saves-helper-content">
                            <strong>{{label}}</strong>
                            <span>{{#if basic}}{{localize "PF2E_V2_PLAYER_CONSOLE.RollFeed.Basic"}} {{/if}}{{saveLabel}} · DC {{dc}}{{#if rolled}} · {{localize "PF2E_V2_PLAYER_CONSOLE.RollFeed.AlreadyRolled"}} {{total}}{{/if}}</span>
                        </div>
                        <button type="button" data-action="rollSavesHelper" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.RollFeed.RollSave'}}" {{#unless rollable}}disabled{{/unless}}{{#if rolled}} disabled{{/if}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button>
                    {{else}}
                        <strong>{{localize "PF2E_V2_PLAYER_CONSOLE.RollFeed.YouRolled"}}</strong>
                        <span>{{label}}{{#if (ne total null)}} <b>{{total}}</b>{{/if}}{{#if degree}} · {{degree}}{{/if}}</span>
                    {{/if}}
                </article>
            {{else}}
                <p class="roll-feed-empty">{{localize "PF2E_V2_PLAYER_CONSOLE.RollFeed.Empty"}}</p>
            {{/each}}
        </div>
    {{/unless}}
</section>
