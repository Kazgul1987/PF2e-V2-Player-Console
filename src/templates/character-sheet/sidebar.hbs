<aside class="character-sidebar" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Sidebar.Label'}}" {{#unless showSidebar}}hidden{{/unless}}>
    {{#if showSidebar}}
    <section class="sidebar-section sidebar-vitals">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Vitals"}}</h2>
        <div class="sidebar-resource hp-resource">
            <span>HP</span>
            <span class="resource-value">
                {{#if editable}}
                    <input type="number" value="{{actor.hp.value}}" data-hp-current aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Sidebar.CurrentHP'}}" />
                {{else}}<strong>{{actor.hp.value}}</strong>{{/if}}
                / {{actor.hp.max}}
            </span>
        </div>
        <div class="sidebar-hp-bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{actor.hp.max}}" aria-valuenow="{{actor.hp.progressValue}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Sidebar.HPBarLabel' value=actor.hp.value max=actor.hp.max}}">
            <span class="sidebar-hp-bar-fill" style="--hp-percent: {{actor.hp.percent}}%;"></span>
        </div>
        {{#if actor.heroPoints}}
            <div class="sidebar-resource hero-resource {{#if editable}}interactive{{/if}}"
                {{#if editable}}data-hero-points role="button" tabindex="0" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Sidebar.HeroPointsHint'}}"{{/if}}
                aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Sidebar.HeroPointsLabel' value=actor.heroPoints.value max=actor.heroPoints.max}}"
                >
                <span>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.HeroPoints"}}</span>
                <span class="resource-pips" aria-hidden="true">
                    {{#each actor.heroPoints.pips}}<i class="resource-pip {{#if filled}}filled{{else}}empty{{/if}}"></i>{{/each}}
                    <small>{{actor.heroPoints.value}} / {{actor.heroPoints.max}}</small>
                </span>
            </div>
        {{/if}}
        {{#if actor.conditions.dying.active}}
            <div class="sidebar-resource condition-resource"><span>{{localize "PF2E.condition.dying.name"}}</span><span class="condition-pips" aria-label="{{actor.conditions.dying.value}} / {{actor.conditions.dying.max}}">{{#each actor.conditions.dying.pips}}<i class="resource-pip {{#if filled}}filled danger{{else}}empty{{/if}}"></i>{{/each}}</span></div>
        {{/if}}
        {{#if actor.conditions.wounded.active}}
            <div class="sidebar-resource condition-resource"><span>{{localize "PF2E.condition.wounded.name"}}</span><span class="condition-pips" aria-label="{{actor.conditions.wounded.value}} / {{actor.conditions.wounded.max}}">{{#each actor.conditions.wounded.pips}}<i class="resource-pip {{#if filled}}filled warning{{else}}empty{{/if}}"></i>{{/each}}</span></div>
        {{/if}}
    </section>
    <section class="sidebar-section">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Defense"}}</h2>
        <div class="sidebar-stat"><i class="sidebar-stat-icon sidebar-stat-icon-defense fa-solid fa-shield-halved" aria-hidden="true"></i><span>AC</span><strong>{{actor.ac}}</strong></div>
        {{#if actor.shield}}
            <div class="sidebar-shield">
                <strong><i class="fa-solid fa-shield-halved"></i> {{actor.shield.name}}</strong>
                <span>Hardness {{actor.shield.hardness}}</span><span>HP {{actor.shield.hp.value}} / {{actor.shield.hp.max}}</span>
                <span>BT {{actor.shield.brokenThreshold}}</span>
                {{#if actor.shield.raised}}<span>{{localize "PF2E_V2_PLAYER_CONSOLE.Character.ShieldRaised"}}</span>{{/if}}
                {{#if actor.shield.broken}}<span>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Broken"}}</span>{{/if}}
                {{#if actor.shield.destroyed}}<span>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Destroyed"}}</span>{{/if}}
            </div>
        {{/if}}
    </section>
    <section class="sidebar-section">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Checks"}}</h2>
        <button type="button" class="sidebar-stat rollable" data-action="rollStatistic" data-statistic="perception"><span class="sidebar-stat-main"><i class="sidebar-stat-icon fa-solid fa-eye" aria-hidden="true"></i><span class="sidebar-stat-label">{{actor.perception.label}}</span><strong class="sidebar-stat-modifier">{{actor.perception.modifier}}</strong></span>{{#if actor.perception.rank}}<span class="sidebar-stat-meta"><small class="proficiency-badge" data-rank="{{actor.perception.rank.value}}">{{actor.perception.rank.label}}</small></span>{{/if}}</button>
        {{#if actor.initiative}}<button type="button" class="sidebar-stat rollable" data-action="rollInitiative"><span class="sidebar-stat-main"><i class="sidebar-stat-icon fa-solid fa-bolt" aria-hidden="true"></i><span class="sidebar-stat-label">{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Initiative"}}</span><strong class="sidebar-stat-modifier">{{actor.initiative.modifier}}</strong></span><span class="sidebar-stat-meta"><small class="sidebar-stat-detail">{{actor.initiative.label}}</small></span></button>{{/if}}
    </section>
    <section class="sidebar-section">
        <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Sidebar.Saves"}}</h2>
        {{#each actor.saves}}
            <button type="button" class="sidebar-stat rollable" data-action="rollStatistic" data-statistic="{{slug}}"><span class="sidebar-stat-main"><i class="sidebar-stat-icon fa-solid {{icon}}" aria-hidden="true"></i><span class="sidebar-stat-label">{{label}}</span><strong class="sidebar-stat-modifier">{{modifier}}</strong></span>{{#if rank}}<span class="sidebar-stat-meta"><small class="proficiency-badge" data-rank="{{rank.value}}">{{rank.label}}</small></span>{{/if}}</button>
        {{/each}}
    </section>
    {{#if actor.defenses.immunities.length}}<section class="sidebar-section sidebar-iwr"><h2>{{localize "PF2E.ImmunitiesLabel"}}</h2><ul>{{#each actor.defenses.immunities}}<li data-iwr-type="{{type}}">{{label}}</li>{{/each}}</ul></section>{{/if}}
    {{#if actor.defenses.weaknesses.length}}<section class="sidebar-section sidebar-iwr"><h2>{{localize "PF2E.WeaknessesLabel"}}</h2><ul>{{#each actor.defenses.weaknesses}}<li data-iwr-type="{{type}}">{{label}}</li>{{/each}}</ul></section>{{/if}}
    {{#if actor.defenses.resistances.length}}<section class="sidebar-section sidebar-iwr"><h2>{{localize "PF2E.ResistancesLabel"}}</h2><ul>{{#each actor.defenses.resistances}}<li data-iwr-type="{{type}}">{{label}}</li>{{/each}}</ul></section>{{/if}}
    {{/if}}
</aside>
