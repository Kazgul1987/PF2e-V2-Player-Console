<section class="tab-panel tab {{tab.cssClass}} spellcasting-tab" data-group="primary" data-tab="spellcasting">
    <h2>{{localize "PF2E_V2_PLAYER_CONSOLE.Tabs.spellcasting"}}</h2>
    {{#if spellcasting.empty}}
        <p class="spell-empty">{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.Empty"}}</p>
    {{else}}
        {{#each spellcasting.entries as |entry|}}
            <article class="spell-entry" data-entry-id="{{entry.id}}">
                <header>
                    <div><h3>{{entry.name}}</h3><div class="spell-entry-meta">
                        {{#if entry.tradition}}<span>{{entry.tradition}}</span>{{/if}}<span>{{entry.category}}</span>
                        {{#if entry.attribute}}<span>{{entry.attribute}}</span>{{/if}}
                    </div></div>
                    <div class="spell-statistics">
                        {{#if entry.canAttack}}<button type="button" data-action="spellAttack" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.RollAttack'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.RollAttack'}}">{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.Attack"}} {{numberFormat entry.attack sign=true}}</button>{{/if}}
                        {{#if entry.dc}}<span title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.DC'}}">{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.DC"}} {{entry.dc}}</span>{{/if}}
                        {{#if @root.editable}}{{#if entry.canPrepareSlots}}<button type="button" class="prepare-spells-button" data-action="openSpellPreparation" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.PrepareSpellsHint'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.PrepareSpells'}}"><i class="fa-solid fa-book-open-reader" aria-hidden="true"></i> {{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.PrepareSpells"}}</button>{{/if}}{{/if}}
                    </div>
                </header>
                {{#each entry.groups as |group|}}
                    <section class="spell-rank" data-entry-id="{{entry.id}}" data-group-id="{{group.id}}">
                        <header><h4>{{group.label}}</h4>{{#if group.isFocusCantrip}}<span class="slot-count infinity" role="img" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Unlimited'}}">&infin; / &infin;</span>{{else}}{{#if group.isFocusPool}}{{#if group.focusPool}}<span class="focus-pool" role="button" tabindex="0" data-focus-resource data-resource="focus" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.FocusPointsAdjustHint'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.FocusPointsLabel' value=group.focusPool.value max=group.focusPool.max}}">
                            <span class="focus-pool-label" aria-hidden="true">{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.FocusPoints"}}</span>
                            <span class="focus-points" aria-hidden="true">{{#each group.focusPool.points as |point|}}<span class="focus-point {{#if point.filled}}filled{{else}}empty{{/if}}"></span>{{/each}}</span>
                            <span class="focus-pool-value" aria-hidden="true">{{group.focusPool.value}} / {{group.focusPool.max}}</span>
                        </span>{{/if}}{{else}}{{#if group.uses}}<span class="slot-count">{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.Slots"}}:
                            {{#if group.editableValue}}{{#if group.editableUses}}{{#if @root.editable}}<input type="number" min="0" inputmode="numeric" data-slot-count data-rank="{{group.number}}" data-field="value" value="{{group.uses.value}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.CurrentSlots'}}">{{else}}{{group.uses.value}}{{/if}}{{else}}{{group.uses.value}}{{/if}}<span>/</span>{{/if}}
                            {{#if group.editableUses}}{{#if @root.editable}}<input type="number" min="0" inputmode="numeric" data-slot-count data-rank="{{group.number}}" data-field="max" value="{{group.uses.max}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.MaximumSlots'}}">{{else}}{{group.uses.max}}{{/if}}{{else}}{{group.uses.max}}{{/if}}
                        </span>{{/if}}{{/if}}{{/if}}</header>
                        <ol>
                        {{#each group.slots as |slot|}}
                            <li class="spell-row {{#if slot.isPreparedSlot}}prepared-slot{{/if}} {{#if slot.empty}}empty{{/if}} {{#if slot.expended}}expended{{/if}}" data-entry-id="{{entry.id}}" data-group-id="{{group.id}}" data-slot-index="{{slot.slotIndex}}" {{#unless slot.empty}}data-spell-id="{{slot.spellId}}" draggable="true"{{/unless}}>
                            {{#if slot.empty}}
                                <span class="slot-state" {{#if slot.canPrepare}}title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.DropToPrepare'}}"{{/if}}><i class="fa-regular fa-square" aria-hidden="true"></i> {{#if slot.isPreparedSlot}}{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.EmptyPreparedSlot"}}{{else}}{{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.EmptySlot"}}{{/if}}</span>
                                {{#if @root.editable}}{{#if slot.canPrepare}}<div class="item-controls"><button type="button" data-action="prepareSpell" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Prepare'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Prepare'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div>{{/if}}{{/if}}
                            {{else}}
                                <button type="button" class="spell-name" data-action="openSpell" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Open'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Open'}}"><img src="{{slot.img}}" alt=""><span><strong>{{slot.name}}</strong><small>{{slot.actionCost}}</small></span></button>
                                <div class="spell-meta">{{#each slot.visibleTraits}}<span class="trait">{{this}}</span>{{/each}}{{#if slot.hiddenTraitCount}}<span class="trait trait-overflow" data-tooltip="{{slot.hiddenTraitLabels}}" title="{{slot.hiddenTraitLabels}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.AdditionalTraits' count=slot.hiddenTraitCount traits=slot.hiddenTraitLabels}}">+{{slot.hiddenTraitCount}}</span>{{/if}}{{#if slot.uses}}<span>{{slot.uses.value}} / {{slot.uses.max}}</span>{{/if}}</div>
                                <span class="slot-state">{{#if slot.expended}}<i class="fa-solid fa-ban" aria-hidden="true"></i> {{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.Expended"}}{{else}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "PF2E_V2_PLAYER_CONSOLE.Spellcasting.Available"}}{{/if}}</span>
                                <div class="item-controls">
                                    {{#if @root.editable}}<button type="button" data-action="castSpell" data-rank="{{slot.castRank}}" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Cast'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Cast'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></button>{{/if}}
                                    <button type="button" data-action="spellSummary" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Summary'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Summary'}}"><i class="fa-solid fa-circle-info"></i></button>
                                    <button type="button" data-action="spellToChat" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Actions.SendToChat'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Actions.SendToChat'}}"><i class="fa-solid fa-message"></i></button>
                                    {{#if @root.editable}}{{#if slot.isPreparedSlot}}<button type="button" data-action="toggleSlotExpended" data-expended="{{slot.expended}}" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.ToggleExpended'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.ToggleExpended'}}"><i class="fa-solid fa-check-double"></i></button><button type="button" data-action="unprepareSpell" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Unprepare'}}" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Spellcasting.Unprepare'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}{{/if}}
                                </div>
                                <div class="item-summary" hidden></div>
                            {{/if}}
                            </li>
                        {{/each}}
                        </ol>
                    </section>
                {{/each}}
            </article>
        {{/each}}
    {{/if}}
</section>
