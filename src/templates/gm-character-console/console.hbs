<header class="gm-console-toolbar">
    <details class="gm-character-selector">
        <summary>{{localize "PF2E_V2_PLAYER_CONSOLE.Console.SelectCharacters"}}</summary>
        <form data-character-selection>
            <strong>{{localize "PF2E_V2_PLAYER_CONSOLE.Console.PlayerOwned"}}</strong>
            {{#each candidates}}<label><input type="checkbox" name="actor" value="{{id}}" {{checked selected}}> {{name}}</label>
            {{else}}<p>{{localize "PF2E_V2_PLAYER_CONSOLE.Console.NoPlayerCharacters"}}</p>{{/each}}
            <button type="submit">{{localize "PF2E_V2_PLAYER_CONSOLE.Console.ApplySelection"}}</button>
        </form>
    </details>
    <div class="gm-focus-selector" role="tablist">
        {{#each selectedActors}}<button type="button" data-action="selectFocused" data-actor-id="{{id}}" aria-pressed="{{focused}}">{{name}}</button>{{/each}}
    </div>
    <div role="group" aria-label="{{localize 'PF2E_V2_PLAYER_CONSOLE.Console.Layout'}}">
        <button type="button" data-action="setLayout" data-layout="columns">{{localize "PF2E_V2_PLAYER_CONSOLE.Console.Columns"}}</button>
        <button type="button" data-action="setLayout" data-layout="grid">{{localize "PF2E_V2_PLAYER_CONSOLE.Console.Grid"}}</button>
        <button type="button" data-action="setLayout" data-layout="focused">{{localize "PF2E_V2_PLAYER_CONSOLE.Console.Focused"}}</button>
    </div>
</header>
<main class="gm-console-panes" data-layout="{{layout}}">
    {{#each panes}}{{> "modules/pf2e-v2-player-console/src/templates/gm-character-console/pane.hbs" this}}
    {{else}}<div class="gm-console-empty"><p>{{localize "PF2E_V2_PLAYER_CONSOLE.Console.Empty"}}</p><button type="button" data-action="selectCharacters">{{localize "PF2E_V2_PLAYER_CONSOLE.Console.SelectCharacters"}}</button></div>{{/each}}
</main>
