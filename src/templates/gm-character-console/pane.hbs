<section class="gm-character-pane" data-actor-id="{{actorId}}" data-pane-id="{{paneId}}">
    <header class="gm-pane-controls">
        <strong>{{view.actor.name}}</strong>
        <button type="button" data-action="focusPane" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Console.Focus'}}"><i class="fa-solid fa-crosshairs"></i></button>
        <button type="button" data-action="openSheet" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Console.OpenSheet'}}"><i class="fa-solid fa-window-restore"></i></button>
        <button type="button" data-action="removePane" title="{{localize 'PF2E_V2_PLAYER_CONSOLE.Console.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
    </header>
    {{> "modules/pf2e-v2-player-console/src/templates/character-sheet/header.hbs" view}}
    {{> "modules/pf2e-v2-player-console/src/templates/character-sheet/sidebar.hbs" view}}
    {{> "modules/pf2e-v2-player-console/src/templates/character-sheet/navigation.hbs" view}}
    {{> template view}}
</section>
